# Master encryption key — 32 bytes hex (64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# Redis (for BullMQ scheduler)
REDIS_URL=redis://localhost:6379

# LLM API keys (primary provider plus fallback)
LLM_KEY_1=
LLM_KEY_2=
LLM_KEY_3=
LLM_KEY_4=
LLM_KEY_5=

# LLM provider configuration
# Set these to provider and model values supported by backend/llm.
LLM_PRIMARY_PROVIDER=
LLM_PRIMARY_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Server
PORT=4000
WS_PORT=4001
